{
  "name": "@globeguide/edge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=../web/out/_worker.js",
    "preview": "wrangler pages dev ../web/out --port 3000",
    "db:migrate:local": "wrangler d1 migrations apply globeguide-beta --local",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run test",
    "seed:social": "node scripts/seed-social-demo.mjs --remote"
  },
  "devDependencies": {
    "@globeguide/domain": "workspace:*",
    "@globeguide/web": "workspace:*",
    "@types/node": "^22.15.30",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "4.156.2"
  }
}
